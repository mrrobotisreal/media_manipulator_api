{
  "version": 1,
  "canvas": {
    "width": 512,
    "height": 512,
    "viewBox": "0 0 512 512",
    "background": "transparent"
  },
  "duration": 3000,
  "fps": 24,
  "layers": [
    {
      "id": "box",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 100,
      "height": 100,
      "fill": "#3366ff",
      "futureField": 1,
      "transform": {
        "x": 20,
        "y": 20,
        "scaleX": 1,
        "scaleY": 1,
        "rotation": 0
      }
    },
    {
      "id": "orb",
      "type": "ellipse",
      "cx": 0,
      "cy": 0,
      "rx": 20,
      "ry": 20,
      "fill": "url(#g)"
    },
    {
      "id": "track",
      "type": "path",
      "d": "M 50 400 Q 256 100 462 400",
      "fill": "none",
      "stroke": "#999999"
    }
  ],
  "defs": {
    "gradients": [
      {
        "id": "g",
        "kind": "linear",
        "stops": [
          {
            "offset": 0,
            "color": "#ff0000"
          },
          {
            "offset": 1,
            "color": "#0000ff"
          }
        ]
      }
    ],
    "masks": [],
    "clipPaths": [],
    "filters": [],
    "symbols": []
  },
  "animations": [
    {
      "layerId": "box",
      "property": "transform.x",
      "keyframes": [
        {
          "t": 0,
          "value": 20,
          "easing": "easeIn"
        },
        {
          "t": 1000,
          "value": 300,
          "easing": "easeOut"
        },
        {
          "t": 2000,
          "value": 100,
          "easing": "easeBoth"
        },
        {
          "t": 3000,
          "value": 20,
          "easing": "linear"
        }
      ]
    },
    {
      "layerId": "box",
      "property": "opacity",
      "keyframes": [
        {
          "t": 0,
          "value": 1,
          "easing": "hold"
        },
        {
          "t": 1500,
          "value": 0.2
        }
      ]
    },
    {
      "layerId": "box",
      "property": "fill",
      "keyframes": [
        {
          "t": 0,
          "value": "#3366ff",
          "easing": {
            "cubicBezier": [
              0.42,
              0,
              0.58,
              1
            ]
          }
        },
        {
          "t": 3000,
          "value": "#ff3366"
        }
      ]
    },
    {
      "layerId": "g",
      "property": "gradientStop[0].color",
      "keyframes": [
        {
          "t": 0,
          "value": "#ff0000"
        },
        {
          "t": 3000,
          "value": "#00ff00"
        }
      ]
    },
    {
      "layerId": "orb",
      "property": "motionPath",
      "keyframes": [
        {
          "t": 0,
          "value": 0,
          "extras": {
            "pathId": "track"
          }
        },
        {
          "t": 3000,
          "value": 1
        }
      ]
    }
  ],
  "loop": true
}
