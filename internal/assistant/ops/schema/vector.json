          "maxLength": 20000,
          "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE.,+\\-\\s]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
