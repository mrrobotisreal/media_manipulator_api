    "color": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(#[0-9A-Fa-f]{3,8}|[A-Za-z]{3,30}|(rgb|rgba|hsl|hsla)\\([0-9.,%\\s/+-]{1,60}\\))$"
