{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "maxItems": 24,
  "type": "array",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "split"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "at": {
            "$ref": "#/$defs/time"
          }
        },
        "required": [
          "op",
          "clipId",
          "at"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "trim"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "sourceIn": {
            "$ref": "#/$defs/time"
          },
          "sourceOut": {
            "$ref": "#/$defs/time"
          }
        },
        "required": [
          "op",
          "clipId"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "sourceIn"
            ]
          },
          {
            "required": [
              "sourceOut"
            ]
          }
        ]
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "move_clip"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "timelineStart": {
            "$ref": "#/$defs/time"
          },
          "track": {
            "$ref": "#/$defs/track_ref"
          }
        },
        "required": [
          "op",
          "clipId",
          "timelineStart"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "delete_clip"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "ripple": {
            "type": "boolean"
          }
        },
        "required": [
          "op",
          "clipId"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_transition"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "type": {
            "type": "string",
            "enum": [
              "crossDissolve",
              "dipToBlack",
              "dipToWhite",
              "wipeLeft",
              "wipeRight",
              "wipeUp",
              "wipeDown",
              "pushLeft",
              "pushRight",
              "pushUp",
              "pushDown",
              "slideLeft",
              "slideRight",
              "slideUp",
              "slideDown"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 5
          }
        },
        "required": [
          "op",
          "clipId",
          "type",
          "durationSeconds"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "grade"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipIds": {
            "$ref": "#/$defs/clip_ids"
          },
          "lumetri": {
            "$ref": "#/$defs/lumetri"
          }
        },
        "required": [
          "op",
          "clipIds",
          "lumetri"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "apply_look"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipIds": {
            "$ref": "#/$defs/clip_ids"
          },
          "lookId": {
            "type": "string",
            "enum": [
              "cinematic",
              "teal-orange",
              "bleach-bypass",
              "warm-film",
              "cool-night",
              "vintage",
              "high-key",
              "noir",
              "pastel",
              "punchy-social",
              "moody",
              "golden-hour"
            ]
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "op",
          "clipIds",
          "lookId"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_transform"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "x": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "scale": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 10
          },
          "rotationDeg": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          }
        },
        "required": [
          "op",
          "clipId"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_keyframes"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "property": {
            "$ref": "#/$defs/keyframe_property"
          },
          "keyframes": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 86400
                },
                "value": {
                  "type": "number"
                },
                "ease": {
                  "$ref": "#/$defs/ease"
                }
              },
              "required": [
                "t",
                "value",
                "ease"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "op",
          "clipId",
          "property",
          "keyframes"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "add_title"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "template": {
            "type": "string",
            "enum": [
              "lowerThird",
              "title",
              "endCard",
              "caption"
            ]
          },
          "lines": {
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "start": {
            "$ref": "#/$defs/time"
          },
          "duration": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 600
          },
          "style": {
            "$ref": "#/$defs/title_style"
          },
          "animateIn": {
            "type": "string",
            "enum": [
              "none",
              "fade",
              "slideLeft",
              "slideRight",
              "slideUp",
              "pop"
            ]
          },
          "animateOut": {
            "type": "string",
            "enum": [
              "none",
              "fade",
              "slideLeft",
              "slideRight",
              "slideDown"
            ]
          }
        },
        "required": [
          "op",
          "template",
          "lines",
          "start",
          "duration"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_speed"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "speed": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10
          },
          "maintainPitch": {
            "type": "boolean"
          }
        },
        "required": [
          "op",
          "clipId",
          "speed"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "freeze_frame"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "at": {
            "$ref": "#/$defs/time"
          },
          "duration": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 60
          }
        },
        "required": [
          "op",
          "clipId",
          "at",
          "duration"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "audio_preset"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "track": {
            "$ref": "#/$defs/track_ref"
          },
          "preset": {
            "type": "string",
            "enum": [
              "voiceClarity",
              "musicBed",
              "podcast"
            ]
          }
        },
        "required": [
          "op",
          "track",
          "preset"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_ducking"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "enabled": {
            "type": "boolean"
          },
          "voiceTrack": {
            "$ref": "#/$defs/track_ref"
          },
          "amountDb": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "attackMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 2000
          },
          "releaseMs": {
            "type": "number",
            "minimum": 0,
            "maximum": 5000
          }
        },
        "required": [
          "op",
          "enabled"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_volume"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "clipId": {
            "$ref": "#/$defs/clip_id"
          },
          "track": {
            "$ref": "#/$defs/track_ref"
          },
          "gainDb": {
            "type": "number",
            "minimum": -60,
            "maximum": 6
          }
        },
        "required": [
          "op",
          "gainDb"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "clipId"
            ]
          },
          {
            "required": [
              "track"
            ]
          }
        ]
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "add_marker"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "at": {
            "$ref": "#/$defs/time"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "op",
          "at",
          "label"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_caption_style"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "look": {
            "type": "string",
            "enum": [
              "bold_pop",
              "karaoke_classic",
              "clean_highlight",
              "minimal",
              "neon",
              "podcast"
            ]
          },
          "fontSizePct": {
            "type": "number",
            "minimum": 1,
            "maximum": 15
          },
          "color": {
            "$ref": "#/$defs/hex_color"
          },
          "backgroundColor": {
            "$ref": "#/$defs/hex_color"
          },
          "backgroundOpacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "position": {
            "type": "string",
            "enum": [
              "bottom",
              "middle",
              "top"
            ]
          },
          "maxWidthPct": {
            "type": "number",
            "minimum": 40,
            "maximum": 100
          },
          "fontFamily": {
            "type": "string",
            "enum": [
              "Inter",
              "Noto Sans",
              "Open Sans",
              "Montserrat",
              "Poppins",
              "Raleway",
              "DejaVu Sans",
              "Oswald",
              "Bebas Neue",
              "Anton",
              "Bangers",
              "Titan One",
              "Lilita One",
              "Bowlby One",
              "Rubik Mono One",
              "Russo One",
              "Playfair Display",
              "Merriweather",
              "Lora",
              "JetBrains Mono",
              "Space Mono",
              "Dancing Script",
              "Pacifico",
              "Noto Sans Hebrew",
              "Noto Sans Arabic",
              "Noto Sans SC",
              "Noto Sans KR"
            ]
          },
          "bold": {
            "type": "boolean"
          },
          "uppercase": {
            "type": "boolean"
          },
          "highlightColor": {
            "$ref": "#/$defs/hex_color"
          },
          "outlineColor": {
            "$ref": "#/$defs/hex_color"
          },
          "outlineWidth": {
            "type": "number",
            "minimum": 0,
            "maximum": 12
          },
          "shadow": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "backgroundMode": {
            "type": "string",
            "enum": [
              "box",
              "none",
              "word_box"
            ]
          },
          "wordsPerGroup": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "animation": {
            "type": "string",
            "enum": [
              "none",
              "karaoke_fill",
              "highlight",
              "pop"
            ]
          },
          "animationStrength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "op"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "look"
            ]
          },
          {
            "required": [
              "fontSizePct"
            ]
          },
          {
            "required": [
              "color"
            ]
          },
          {
            "required": [
              "backgroundColor"
            ]
          },
          {
            "required": [
              "backgroundOpacity"
            ]
          },
          {
            "required": [
              "position"
            ]
          },
          {
            "required": [
              "maxWidthPct"
            ]
          },
          {
            "required": [
              "fontFamily"
            ]
          },
          {
            "required": [
              "bold"
            ]
          },
          {
            "required": [
              "uppercase"
            ]
          },
          {
            "required": [
              "highlightColor"
            ]
          },
          {
            "required": [
              "outlineColor"
            ]
          },
          {
            "required": [
              "outlineWidth"
            ]
          },
          {
            "required": [
              "shadow"
            ]
          },
          {
            "required": [
              "backgroundMode"
            ]
          },
          {
            "required": [
              "wordsPerGroup"
            ]
          },
          {
            "required": [
              "animation"
            ]
          },
          {
            "required": [
              "animationStrength"
            ]
          }
        ]
      },
      {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "const": "set_canvas"
          },
          "reason": {
            "$ref": "#/$defs/reason"
          },
          "aspect": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1",
              "4:5"
            ]
          }
        },
        "required": [
          "op",
          "aspect"
        ],
        "additionalProperties": false
      }
    ]
  },
  "$defs": {
    "reason": {
      "type": "string",
      "minLength": 4,
      "maxLength": 140
    },
    "clip_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "time": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "track_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "clip_ids": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip_id"
          }
        }
      ]
    },
    "lumetri": {
      "type": "object",
      "properties": {
        "exposure": {
          "type": "number",
          "minimum": -3,
          "maximum": 3
        },
        "contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "temperature": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "tint": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "vibrance": {
          "type": "number",
          "minimum": -2,
          "maximum": 2
        }
      },
      "additionalProperties": false
    },
    "keyframe_property": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "positionX",
            "positionY",
            "scale",
            "rotation",
            "opacity",
            "volume",
            "pan"
          ]
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}\\.(exposure|contrast|saturation|temperature|tint|vibrance)$"
        }
      ]
    },
    "ease": {
      "type": "string",
      "enum": [
        "linear",
        "hold",
        "easeIn",
        "easeOut",
        "easeBoth"
      ]
    },
    "title_style": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string",
          "enum": [
            "Inter",
            "Noto Sans",
            "Open Sans",
            "Montserrat",
            "Poppins",
            "Raleway",
            "DejaVu Sans",
            "Oswald",
            "Bebas Neue",
            "Anton",
            "Playfair Display",
            "Merriweather",
            "Lora",
            "JetBrains Mono",
            "Space Mono",
            "Dancing Script",
            "Pacifico"
          ]
        },
        "fontSizePx": {
          "type": "number",
          "minimum": 8,
          "maximum": 500
        },
        "fontWeight": {
          "anyOf": [
            {
              "type": "number",
              "const": 400
            },
            {
              "type": "number",
              "const": 700
            }
          ]
        },
        "fillColor": {
          "$ref": "#/$defs/hex_color"
        },
        "strokeColor": {
          "$ref": "#/$defs/hex_color"
        },
        "strokeWidthPx": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "letterSpacingPx": {
          "type": "number",
          "minimum": -20,
          "maximum": 100
        },
        "lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "align": {
          "type": "string",
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "backgroundColor": {
          "$ref": "#/$defs/hex_color"
        },
        "backgroundOpacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "hex_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
