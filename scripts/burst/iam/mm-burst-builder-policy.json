{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LaunchBuilderOnlyAllowedTypesTaggedWithWorkerProfile",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-west-2:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": ["g6.xlarge", "g7.2xlarge"],
          "aws:RequestTag/mm-burst": "1"
        },
        "ArnEquals": {
          "ec2:InstanceProfile": "arn:aws:iam::ACCOUNT_ID:instance-profile/mm-burst-worker"
        },
        "Null": {
          "aws:RequestTag/mm-burst-build": "false"
        }
      }
    },
    {
      "Sid": "LaunchVolumesTagged",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-west-2:ACCOUNT_ID:volume/*",
      "Condition": {
        "StringEquals": { "aws:RequestTag/mm-burst": "1" }
      }
    },
    {
      "Sid": "LaunchUsesTheseResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-west-2::image/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:image/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:subnet/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:network-interface/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:security-group/*"
      ]
    },
    {
      "Sid": "TagOnlyWhileLaunching",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:volume/*"
      ],
      "Condition": {
        "StringEquals": { "ec2:CreateAction": "RunInstances" }
      }
    },
    {
      "Sid": "CreateImageFromTaggedBuilder",
      "Effect": "Allow",
      "Action": "ec2:CreateImage",
      "Resource": "arn:aws:ec2:us-west-2:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/mm-burst": "1" }
      }
    },
    {
      "Sid": "CreateImageAndSnapshotsOnlyTaggedAsBurstImage",
      "Effect": "Allow",
      "Action": "ec2:CreateImage",
      "Resource": [
        "arn:aws:ec2:us-west-2::image/*",
        "arn:aws:ec2:us-west-2::snapshot/*"
      ],
      "Condition": {
        "StringEquals": { "aws:RequestTag/mm-burst-image": "1" }
      }
    },
    {
      "Sid": "TagOnlyWhileCreatingImage",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-west-2::image/*",
        "arn:aws:ec2:us-west-2::snapshot/*"
      ],
      "Condition": {
        "StringEquals": { "ec2:CreateAction": "CreateImage" }
      }
    },
    {
      "Sid": "TerminateOnlyBurstMachines",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:us-west-2:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/mm-burst": "1" }
      }
    },
    {
      "Sid": "DeregisterOnlyBurstImages",
      "Effect": "Allow",
      "Action": "ec2:DeregisterImage",
      "Resource": "arn:aws:ec2:us-west-2::image/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/mm-burst-image": "1" }
      }
    },
    {
      "Sid": "DeleteOnlyBurstImageSnapshots",
      "Effect": "Allow",
      "Action": "ec2:DeleteSnapshot",
      "Resource": "arn:aws:ec2:us-west-2::snapshot/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/mm-burst-image": "1" }
      }
    },
    {
      "Sid": "ReadOnlyLookups",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "ResolveTheDeepLearningAmi",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:us-west-2::parameter/aws/service/deeplearning/*"
    },
    {
      "Sid": "HandTheBuilderTheWorkerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/mm-burst-worker",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ec2.amazonaws.com" }
      }
    },
    {
      "Sid": "BuildBundlesAndResultsUnderBurst",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::media-manipulator/burst/*"
    },
    {
      "Sid": "ReadExportedRuntimes",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::media-manipulator/burst-images/*"
    },
    {
      "Sid": "ListOnlyBurstPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::media-manipulator",
      "Condition": {
        "StringLike": { "s3:prefix": ["burst/*", "burst-images/*"] }
      }
    }
  ]
}
