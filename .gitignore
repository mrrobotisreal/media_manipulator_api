.env
main
!api/main.go
outputs/
uploads/
!cmd/api/main.go
double-raven-mm-firebase.json

# macOS / system junk
.DS_Store
**/.DS_Store
._*
**/._*

# Python cache from helper scripts
__pycache__/
**/__pycache__/

# Don't commit downloaded RIFE binaries, models, or temp outputs that may
# accidentally end up under scripts/server/ during local manual testing.
scripts/server/bin/
scripts/server/models/
scripts/server/tmp/
scripts/server/*.zip
scripts/server/*.tar.gz
gfpgan/

# Stray directory created by internal/services tests (pre-existing test-hygiene issue).
internal/services/job-*/

# Compiled command binaries. `go build ./cmd/<name>` drops <name> in the repo
# root; none of them is ever committed. (`main` above covers `go build .`.)
/api
/grant-tier
/operator-check
/parity-render

# Never commit credential files (MM37). The server keeps its own file where GOOGLE_APPLICATION_CREDENTIALS points; leave that as is.
*firebase*.json
*service-account*.json
